{
  "manifest_version": 3,
  "name": "AI Trading Scanner",
  "version": "0.11.14",
  "key": "",
  "description": "Scanner Sniper M1 para CasaTrade: OHLC numérico, possível aos 30s, decisão aos 10s, confirmação manual e resultado da vela-alvo.",
  "permissions": ["storage","activeTab","scripting","sidePanel"],
  "host_permissions": [
    "https://casatrade.com/*","https://*.casatrade.com/*","https://casatrade.io/*","https://*.casatrade.io/*",
    "https://casatraders.online/*","https://*.casatraders.online/*","https://ivcasatraders.online/*","https://*.ivcasatraders.online/*",
    "https://ats-control-center-v07-production.up.railway.app/*","https://ai-trading-scanner-production-62f2.up.railway.app/*"
  ],
  "background": {"service_worker":"src/background-entry.js","type":"module"},
  "action": {"default_title":"AI Trading Scanner"},
  "options_page":"src/admin/index.html",
  "side_panel":{"default_path":"src/sidepanel/index.html"},
  "content_scripts": [
    {
      "matches":["https://casatrade.com/*","https://*.casatrade.com/*","https://casatrade.io/*","https://*.casatrade.io/*"],
      "js":["src/content/runtime-message-compat.js","src/content/runtime-boot-probe.js","src/content/sniper-page-bootstrap.js","src/content/device-anchor.js","src/content/opaque-frame-top-bridge.js"],
      "run_at":"document_start","all_frames":false
    },
    {
      "matches":["https://casatrade.com/*","https://*.casatrade.com/*","https://casatrade.io/*","https://*.casatrade.io/*","https://casatraders.online/*","https://*.casatraders.online/*","https://ivcasatraders.online/*","https://*.ivcasatraders.online/*"],
      "js":["src/content/runtime-message-compat.js","src/content/runtime-boot-probe.js","src/content/sniper-page-bootstrap.js","src/content/opaque-frame-recovery.js","src/content/casatrade-asset-observer.js","src/content/embedded-feed-bridge.js","src/content/casatrade-controls-observer.js","src/content/casatrade-live-clock.js","src/content/manual-trade-observer.js"],
      "run_at":"document_start","all_frames":true,"match_origin_as_fallback":true
    },
    {
      "matches":["https://casatrade.com/*","https://*.casatrade.com/*","https://casatrade.io/*","https://*.casatrade.io/*","https://casatraders.online/*","https://*.casatraders.online/*","https://ivcasatraders.online/*","https://*.ivcasatraders.online/*"],
      "js":["src/content/page-world-sentinel.js","src/content/standalone-instrument-probe.js","src/content/worker-probe.js","src/content/network-probe.js"],
      "run_at":"document_start","world":"MAIN","all_frames":true,"match_origin_as_fallback":true
    }
  ],
  "web_accessible_resources":[{
    "resources":["src/content/page-world-sentinel.js","src/content/standalone-instrument-probe.js","src/content/worker-probe.js","src/content/network-probe.js"],
    "matches":["https://casatrade.com/*","https://*.casatrade.com/*","https://casatrade.io/*","https://*.casatrade.io/*","https://casatraders.online/*","https://*.casatraders.online/*","https://ivcasatraders.online/*","https://*.ivcasatraders.online/*"]
  }],
  "version_name":"0.11.14-sniper-runtime-hardening"
}
