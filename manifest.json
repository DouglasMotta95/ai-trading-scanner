{
  "manifest_version": 3,
  "name": "AI Trading Scanner",
  "version": "0.10.1",
  "description": "Scanner inteligente multi-plataforma com WebSocket de baixa latência, análise prática de 3–5 velas, IA ponderada, gestão de risco e terminal profissional.",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": [
    "https://*.casatrade.com/*",
    "https://*.casatrade.io/*",
    "https://ats-control-center-v07-production.up.railway.app/*"
  ],
  "background": { "service_worker": "src/background-entry.js", "type": "module" },
  "action": { "default_title": "AI Trading Scanner" },
  "options_page": "src/admin/index.html",
  "side_panel": { "default_path": "src/sidepanel/index.html" },
  "content_scripts": [
    {
      "matches": ["https://*.casatrade.com/*", "https://*.casatrade.io/*"],
      "js": ["src/content/network-probe.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.casatrade.com/*", "https://*.casatrade.io/*"],
      "js": ["src/content/network-bridge.js", "src/content/generic-adapter.js", "src/content/platform-sync.js", "src/content/history-adapter.js", "src/content/chart-overlay.js"],
      "run_at": "document_start"
    }
  ]
}
