{
  "manifest_version": 3,
  "name": "AI Trading Scanner",
  "version": "0.10.1",
  "key": "",
  "description": "Scanner de sinais para CasaTrade com leitura de mercado real, sincronização de operação e confirmação manual.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://casatrade.com/*",
    "https://*.casatrade.com/*",
    "https://casatrade.io/*",
    "https://*.casatrade.io/*",
    "https://casatraders.online/*",
    "https://*.casatraders.online/*",
    "https://ivcasatraders.online/*",
    "https://*.ivcasatraders.online/*",
    "https://ats-control-center-v07-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "src/background-entry.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI Trading Scanner"
  },
  "options_page": "src/admin/index.html",
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://casatrade.com/*",
        "https://*.casatrade.com/*",
        "https://casatrade.io/*",
        "https://*.casatrade.io/*"
      ],
      "js": [
        "src/content/focused-asset.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://casatrade.com/*",
        "https://*.casatrade.com/*",
        "https://casatrade.io/*",
        "https://*.casatrade.io/*",
        "https://casatraders.online/*",
        "https://*.casatraders.online/*",
        "https://ivcasatraders.online/*",
        "https://*.ivcasatraders.online/*"
      ],
      "js": [
        "src/content/worker-probe.js",
        "src/content/canvas-probe.js",
        "src/content/network-probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://casatrade.com/*",
        "https://*.casatrade.com/*",
        "https://casatrade.io/*",
        "https://*.casatrade.io/*",
        "https://casatraders.online/*",
        "https://*.casatraders.online/*",
        "https://ivcasatraders.online/*",
        "https://*.ivcasatraders.online/*"
      ],
      "js": [
        "src/content/network-bridge.js",
        "src/content/embedded-feed-bridge.js",
        "src/content/generic-adapter.js",
        "src/content/platform-sync.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
