{
  "manifest_version": 3,
  "name": "AI Trading Scanner",
  "version": "0.9.2",
  "description": "Scanner inteligente multi-plataforma com conta do cliente, análise quantitativa, licenciamento invisível, telemetria segura e operação em tempo real.",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": [
    "https://*.casatrade.com/*",
    "https://*.casatrade.io/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": {
    "default_title": "AI Trading Scanner",
    "default_popup": "src/sidepanel/index.html"
  },
  "options_page": "src/admin/index.html",
  "side_panel": { "default_path": "src/sidepanel/index.html" },
  "content_scripts": [
    {
      "matches": [
        "https://*.casatrade.com/*",
        "https://*.casatrade.io/*"
      ],
      "js": ["src/content/network-probe.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.casatrade.com/*",
        "https://*.casatrade.io/*"
      ],
      "js": ["src/content/network-bridge.js", "src/content/generic-adapter.js"],
      "run_at": "document_start"
    }
  ]
}
