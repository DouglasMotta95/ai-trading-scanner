{
  "manifest_version": 3,
  "name": "AI Trading Scanner",
  "version": "0.10.9",
  "key": "",
  "description": "Scanner de sinais para CasaTrade com leitura de mercado real, sincronização de operação e confirmação manual.",
  "permissions": ["storage","activeTab","scripting","sidePanel"],
  "host_permissions": [
    "https://casatrade.com/*","https://*.casatrade.com/*","https://casatrade.io/*","https://*.casatrade.io/*",
    "https://casatraders.online/*","https://*.casatraders.online/*","https://ivcasatraders.online/*","https://*.ivcasatraders.online/*",
    "https://ats-control-center-v07-production.up.railway.app/*"
  ],
  "background": { "service_worker": "src/background-entry.js", "type": "module" },
  "action": { "default_title": "AI Trading Scanner" },
  "options_page": "src/admin/index.html",
  "side_panel": { "default_path": "src/sidepanel/index.html" },
  "content_scripts": [
    {
      "matches": ["https://casatrade.com/*","https://*.casatrade.com/*","https://casatrade.io/*","https://*.casatrade.io/*"],
      "js": ["src/content/device-anchor.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://casatraders.online/*","https://*.casatraders.online/*","https://ivcasatraders.online/*","https://*.ivcasatraders.online/*"],
      "js": ["src/content/focused-asset-protocol.js","src/content/focused-asset-v2.js","src/content/chart-frame-market-reader.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://casatrade.com/*","https://*.casatrade.com/*","https://casatrade.io/*","https://*.casatrade.io/*",
        "https://casatraders.online/*","https://*.casatraders.online/*","https://ivcasatraders.online/*","https://*.ivcasatraders.online/*"
      ],
      "js": ["src/content/worker-probe.js","src/content/canvas-probe.js","src/content/network-probe.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://casatrade.com/*","https://*.casatrade.com/*","https://casatrade.io/*","https://*.casatrade.io/*",
        "https://casatraders.online/*","https://*.casatraders.online/*","https://ivcasatraders.online/*","https://*.ivcasatraders.online/*"
      ],
      "js": [
        "src/content/embedded-feed-bridge.js","src/content/platform-sync.js","src/content/market-cycle-clock-v3.js",
        "src/content/casatrade-data-inspector.js","src/content/analysis-visual-overlay-v2.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "version_name": "0.10.9-demo-single-session"
}
