PORT=8787
NODE_ENV=production

# API / admin
ATS_API_KEY=change-me
ATS_ADMIN_KEY=change-admin-me
# Required in production. Use a random secret with at least 32 characters.
# NUNCA USE ESTE VALOR EM PRODUÇÃO. Gere um segredo aleatório e exclusivo.
SESSION_SECRET=COLOQUE_AQUI_UM_SEGREDO_UNICO_GERADO
ADMIN_SESSION_DAYS=30
CUSTOMER_SESSION_DAYS=30
ACCOUNT_TOKEN_DAYS=30
ATS_DATA_DIR=/data

# Public URL used in verification links and payment callbacks
PUBLIC_BASE_URL=https://ats-control-center-v07-production.up.railway.app
CORS_ORIGINS=chrome-extension://YOUR_EXTENSION_ID,http://localhost:5500

# Transactional e-mail (required for e-mail/password signup)
# Create/verify the sender/domain in Resend first. Never commit the real API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=AI Trading Scanner <contato@seudominio.com>

# Optional Google login
GOOGLE_CLIENT_ID=

# Optional Gemini audit. Keep the real key only in Railway/server variables;
# never put it in manifest.json, extension source or browser storage.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional Mercado Pago checkout
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Optional platform/support links
CASA_TRADE_URL=https://trade.casatrade.com
SUPPORT_WHATSAPP=5535991429262

# License limits
PLAN_TRIAL_SIGNALS=2
PLAN_TRIAL_TOTAL_SIGNALS=2
PLAN_STARTER_SIGNALS=10
PLAN_PRO_SIGNALS=30
PLAN_PRO_DEVICES=1
PLAN_UNLIMITED_DEVICES=1

# Commercial prices
SALES_STARTER_PRICE=79.90
SALES_PRO_PRICE=149.90
SALES_UNLIMITED_PRICE=299.90
SALES_LIFETIME_PRICE=2997.00

# Official release ZIP shown in the customer portal
EXTENSION_DOWNLOAD_URL=
