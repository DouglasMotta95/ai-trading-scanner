# AI Trading Scanner backend — exemplo local.
# Copie para backend/.env e substitua todos os valores de exemplo.
# Nunca comite o arquivo .env real nem segredos de produção.
NODE_ENV=development
PORT=8787
ATS_API_KEY=COLOQUE_AQUI_CHAVE_API_LOCAL
ATS_ADMIN_KEY=COLOQUE_AQUI_CHAVE_ADMIN_LOCAL
# NUNCA USE ESTE VALOR EM PRODUÇÃO
SESSION_SECRET=COLOQUE_AQUI_UM_SEGREDO_UNICO_GERADO
ADMIN_SESSION_DAYS=30
CUSTOMER_SESSION_DAYS=30
ACCOUNT_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:8787
ATS_DATA_DIR=./data
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
EMAIL_FROM=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:8787
CASA_TRADE_URL=https://casatrade.com/
SUPPORT_WHATSAPP=
EXTENSION_DOWNLOAD_URL=
# A versão anunciada é derivada de manifest.json; não configure manualmente.
